BGITU__DEBUG=1
BGITU__LOGGER__LEVEL=DEBUG

BGITU__JWT__ACCESS_SECRET_KEY=secret-key-for-access
BGITU__JWT__ALGORITHM=HS256
BGITU__JWT__ACCESS_TOKEN_EXPIRE_MINUTES=10
BGITU__JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

BGITU__DB__HOST=localhost
BGITU__DB__PORT=5432
BGITU__DB__USERNAME=username
BGITU__DB__PASSWORD=password
BGITU__DB__DATABASE=my_database

BGITU__CELERY__BROKER_URL=redis://localhost:6379/0
BGITU__CELERY__RESULT_BACKEND=redis://localhost:6379/1
BGITU__CELERY__TIMEZONE=UTC

BGITU__CACHE__REDIS_URL=redis://localhost:6379/3
BGITU__CACHE__USER_TTL_SECONDS=600
BGITU__CACHE__OFFICE_SHORT_TTL_SECONDS=300
BGITU__CACHE__ANALYTICS_FILTER_OPTIONS_TTL_SECONDS=300

BGITU__STORAGE__BACKEND=minio
BGITU__STORAGE__ENDPOINT=localhost:9000
BGITU__STORAGE__ACCESS_KEY=minioadmin
BGITU__STORAGE__SECRET_KEY=minioadmin
BGITU__STORAGE__BUCKET=bgitu-files
BGITU__STORAGE__SECURE=false

BGITU__WEBSOCKET__ENABLED=1
BGITU__WEBSOCKET__TRANSPORT=redis
BGITU__WEBSOCKET__REDIS_URL=redis://localhost:6379/2
BGITU__WEBSOCKET__PUBSUB_CHANNEL=ws:broadcast
BGITU__WEBSOCKET__INSTANCE_TTL_SECONDS=30
BGITU__WEBSOCKET__CONNECTION_TTL_SECONDS=30
BGITU__WEBSOCKET__HEARTBEAT_INTERVAL_SECONDS=10
BGITU__WEBSOCKET__CLEANUP_INTERVAL_SECONDS=30

BGITU__FRONTEND_URL=http://localhost:5173
BGITU__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
BGITU__TRUSTED_PROXY_IPS=[]

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
